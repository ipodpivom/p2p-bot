# Не отправляй этот файл с заполненными ключами другим людям.
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_IDS=
# Additional users: each Telegram ID must have a DIFFERENT personal spreadsheet.
USER_SPREADSHEETS_JSON={}
GOOGLE_SPREADSHEET_ID=YOUR_SPREADSHEET_ID
GOOGLE_SHEET_NAME="P2P Учет"
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
DATA_DIR=data
# Render sets PORT automatically. Optional for local HTTP monitoring:
# PORT=10000
# Free Render: use Firestore instead of relying on the local SQLite cache.
STATE_BACKEND=sqlite
# FIRESTORE_PROJECT_ID=your-google-project-id
